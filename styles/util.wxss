/**
 * styles/util.wxss
 * 功能：封装全局可复用的排版、颜色、间距、栅格、按钮与辅助类，页面仅需组合类名即可完成视觉搭建。
 * 用法：WXML 中通过 class="card p-24 shadow-sm" 等组合调用；若需新增形态，优先补充此文件保持一致性。
 * 尺寸（可调）：所有 padding/margin/gap 均读取 --spacing-* 变量，字号/圆角引用 vars.wxss 令牌即可同步改动。
 * 背景/配色（可调）：.bg-*、.text-*、.border-* 均使用 CSS 变量，换肤时只需调整 vars.wxss。
 * 位置/布局：提供 flex/grid、栅格间距、固定底栏（safe-area-bottom）等布局工具，便于快速响应不同屏幕。
 * 交互（事件/回调）：按钮态通过 :active 与透明度控制；如需 loading/disabled，结合 WXSS 的 disabled 伪类使用。
 * 依赖/风险：依赖 styles/vars.wxss 定义变量，确保 app.wxss import 顺序为 reset → vars → util；避免在页面内重复定义同名类。
 * 后期修改指引：新增常用工具→先在此统一；若要扩展暗黑模式，可追加数据属性选择器覆盖颜色类。
 */

/* 间距工具 */
.p-16 { padding: var(--spacing-16); }
.p-20 { padding: var(--spacing-20); }
.p-24 { padding: var(--spacing-24); }
.p-32 { padding: var(--spacing-32); }
.px-24 { padding-left: var(--spacing-24); padding-right: var(--spacing-24); }
.py-16 { padding-top: var(--spacing-16); padding-bottom: var(--spacing-16); }
.mt-12 { margin-top: var(--spacing-12); }
.mt-16 { margin-top: var(--spacing-16); }
.mt-20 { margin-top: var(--spacing-20); }
.mt-24 { margin-top: var(--spacing-24); }
.mt-32 { margin-top: var(--spacing-32); }
.mt-40 { margin-top: var(--spacing-40); }
.mt-48 { margin-top: var(--spacing-48); }
.mb-16 { margin-bottom: var(--spacing-16); }
.mb-24 { margin-bottom: var(--spacing-24); }
.mb-32 { margin-bottom: var(--spacing-32); }
.gap-8 { gap: var(--spacing-8); }
.gap-12 { gap: var(--spacing-12); }
.gap-16 { gap: var(--spacing-16); }
.gap-20 { gap: var(--spacing-20); }
.gap-24 { gap: var(--spacing-24); }
.gap-32 { gap: var(--spacing-32); }

/* 排版与颜色 */
.text-xs { font-size: var(--font-xs); line-height: var(--line-xs); }
.text-sm { font-size: var(--font-sm); line-height: var(--line-sm); }
.text-md { font-size: var(--font-md); line-height: var(--line-md); }
.text-lg { font-size: var(--font-lg); line-height: var(--line-lg); }
.text-xl { font-size: var(--font-xl); line-height: var(--line-xl); }
.text-xxl { font-size: var(--font-xxl); line-height: var(--line-xxl); }
.text-muted { color: var(--color-muted); }
.text-primary { color: var(--color-primary); }
.text-accent { color: var(--color-accent); }
.text-bold { font-weight: 600; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* 背景/边框与浮层 */
.bg-card { background: var(--color-card); }
.bg-page { background: var(--color-bg); }
.bg-accent-soft { background: var(--color-accent-soft); }
.border-line { border: 1rpx solid var(--color-line); }
.rounded-sm { border-radius: var(--radius-sm); }
.rounded-md { border-radius: var(--radius-md); }
.rounded-lg { border-radius: var(--radius-lg); }
.rounded-pill { border-radius: var(--radius-pill); }
.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }

/* 布局工具 */
.flex { display: flex; }
.inline-flex { display: inline-flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }
.flex-wrap { display: flex; flex-wrap: wrap; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-24); }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-16); }
.full-width { width: 100%; }
.safe-area-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--spacing-16));
  padding-bottom: calc(constant(safe-area-inset-bottom) + var(--spacing-16));
}
.sticky-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  box-shadow: 0 -10rpx 30rpx rgba(39, 33, 30, 0.08);
  padding: var(--spacing-16) var(--spacing-24);
}
.page-container {
  background: var(--color-bg);
  min-height: 100vh;
  padding: var(--spacing-24);
}

/* 分割线 */
.divider { height: 1rpx; background: var(--color-line); }

/* 标签与徽章 */
.badge {
  padding: 0 var(--spacing-8);
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  line-height: var(--line-xs);
  display: inline-flex;
  align-items: center;
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

/* 按钮体系 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  line-height: var(--line-md);
  padding: var(--spacing-12) var(--spacing-24);
  border-radius: var(--radius-md);
  transition: opacity 0.2s;
}
.btn:active { opacity: 0.88; }
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #ffffff;
}
.btn-outline {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  background: transparent;
}
.btn-ghost {
  color: var(--color-primary);
  background: rgba(107, 78, 61, 0.08);
}
.btn-danger {
  background: var(--color-danger);
  color: #ffffff;
}

/* 卡片容器 */
.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

/* 表单控件 */
.input-pill {
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  padding: var(--spacing-8) var(--spacing-16);
}

/* 滚动阴影辅助 */
.scroll-fade::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 40rpx;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(247, 248, 250, 0), rgba(247, 248, 250, 1));
}
