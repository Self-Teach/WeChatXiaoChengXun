/**
 * styles/vars.wxss
 * 功能：集中维护品牌色板、字号、间距、圆角与阴影，方便全局统一调整视觉风格。
 * 用法：在 app.wxss 以 @import 引入后，其他 WXSS 可通过 var() 函数引用 CSS 变量。
 * 尺寸：提供 spacing-4 ~ spacing-48 等阶梯变量；字号从 20rpx 到 40rpx。
 * 背景/配色：定义普洱褐、翠绿、米白等云南茶主题色；根据需要在此增加色值。
 * 位置/布局：提供通用阴影、边框、圆角变量，配合 util.wxss 构成布局体系。
 * 交互：按钮 hover/active 的色彩也在此定义，确保交互反馈一致。
 * 依赖/风险：依赖微信小程序基础库 2.10+ 对 CSS 变量的支持，v2 项目默认满足。
 * 后期修改指引：若需换主题或深色模式，仅需集中调整这里的变量，再查看 util.wxss 是否需要补充。
 */
:root {
  /* 色板（云南茶主色、点缀色、背景与文本色） */
  --color-primary: #0a8a4a;
  --color-primary-light: #13b067;
  --color-accent: #c26b3a;
  --color-bg: #f6f7fb;
  --color-card: #ffffff;
  --color-muted: #8a8a8a;
  --color-text: #1f1f1f;
  --color-border: rgba(10, 138, 74, 0.15);
  --color-shadow: rgba(13, 52, 35, 0.08);
  --color-warning: #e39d3c;

  /* 字号刻度（rpx 单位，直接应用在 font-size） */
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;

  /* 行高（与字号配套使用） */
  --line-xs: 34rpx;
  --line-sm: 40rpx;
  --line-md: 44rpx;
  --line-lg: 52rpx;
  --line-xl: 60rpx;

  /* 间距刻度（用于 margin/padding 工具类） */
  --spacing-4: 8rpx;
  --spacing-8: 16rpx;
  --spacing-12: 24rpx;
  --spacing-16: 32rpx;
  --spacing-20: 40rpx;
  --spacing-24: 48rpx;
  --spacing-32: 64rpx;
  --spacing-40: 80rpx;
  --spacing-48: 96rpx;

  /* 圆角与阴影 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --shadow-sm: 0 6rpx 20rpx rgba(13, 52, 35, 0.08);
  --shadow-md: 0 10rpx 28rpx rgba(13, 52, 35, 0.12);
  --shadow-lg: 0 16rpx 40rpx rgba(13, 52, 35, 0.16);
}
