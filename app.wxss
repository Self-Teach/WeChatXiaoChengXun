/**
 * 全局样式，定义主色调和基础布局
 */
page {
  background-color: #f5f5f5;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a4c2d;
  margin: 24rpx 0 16rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #1a4c2d, #2d8a55);
  color: #ffffff;
  border-radius: 48rpx;
  padding: 16rpx 32rpx;
  text-align: center;
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(26, 76, 45, 0.1);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
