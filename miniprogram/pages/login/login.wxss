/* pages/login/login.wxss */
.login-page {
  padding: 32rpx;
}

.welcome {
  background: linear-gradient(135deg, #1a5b34 0%, #2d8c4f 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 40rpx;
  box-shadow: 0 16rpx 28rpx rgba(26, 91, 52, 0.25);
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
}

.welcome-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
  line-height: 1.5;
}

.form-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.05);
}

.form-label {
  font-size: 28rpx;
  color: #1a5b34;
  font-weight: 600;
}

.form-input {
  border: none;
  font-size: 28rpx;
  color: #333;
}

.submit-btn {
  margin-top: 32rpx;
}
