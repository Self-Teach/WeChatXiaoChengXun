<!-- pages/login/login.wxml -->
<view class="login-page">
  <view class="welcome">
    <text class="welcome-title">欢迎登录云南茶叶优选</text>
    <text class="welcome-desc">登录后可同步购物车、订单与收货地址信息。</text>
  </view>

  <form bindsubmit="submitForm">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" name="name" placeholder="请输入姓名" value="{{formData.name}}" bindinput="handleInput" data-field="name"/>
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" name="phone" placeholder="请输入手机号" value="{{formData.phone}}" bindinput="handleInput" data-field="phone" type="number" maxlength="11"/>
    </view>
    <view class="form-item">
      <text class="form-label">头像链接（可选）</text>
      <input class="form-input" name="avatar" placeholder="粘贴头像图片链接" value="{{formData.avatar}}" bindinput="handleInput" data-field="avatar"/>
    </view>
    <button class="btn-primary submit-btn" formType="submit">保存信息</button>
  </form>
</view>
