/* pages/knowledge/knowledge.wxss */
.header {
  position: relative;
  height: 300rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.header-image {
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.65) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32rpx;
  color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.88;
  margin-top: 12rpx;
  line-height: 1.4;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a5b34;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.card-highlight {
  color: #1a5b34;
  font-weight: 500;
}

.divider {
  height: 2rpx;
  background: linear-gradient(90deg, rgba(26, 91, 52, 0.1) 0%, rgba(26, 91, 52, 0.45) 100%);
}
