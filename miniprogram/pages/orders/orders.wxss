/* pages/orders/orders.wxss */
.orders-page {
  padding: 32rpx;
  box-sizing: border-box;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #888;
}

.order-id {
  font-weight: 600;
  color: #1a5b34;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a5b34;
}

.order-spec {
  font-size: 24rpx;
  color: #999;
}

.order-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.order-quantity {
  font-size: 26rpx;
  color: #666;
}

.order-price {
  font-size: 28rpx;
  color: #e16b2d;
  font-weight: 600;
}

.order-summary {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #1a5b34;
  font-weight: 600;
}

.empty {
  padding: 160rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.empty-image {
  width: 220rpx;
  height: 220rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #888;
  text-align: center;
  line-height: 1.6;
}
