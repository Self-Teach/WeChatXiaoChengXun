/* pages/index/index.wxss */
.hero {
  background: linear-gradient(135deg, #1a5b34 0%, #2d8c4f 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: stretch;
  color: #fff;
  margin-bottom: 32rpx;
}

.hero-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.5;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.hero-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  margin-left: 24rpx;
}

.goods-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 24rpx;
}

.goods-card {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  position: relative;
}

.goods-image {
  width: 100%;
  height: 220rpx;
}

.goods-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a5b34;
}

.goods-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.goods-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.goods-price {
  font-weight: 700;
  color: #e16b2d;
}

.goods-stock {
  color: #999;
}

.goods-weight {
  font-size: 24rpx;
  color: #888;
}

.add-btn {
  margin: 0 24rpx 24rpx;
}

.cart-fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 120rpx;
  height: 120rpx;
  background: #1a5b34;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(26, 91, 52, 0.35);
  z-index: 99;
}

.cart-icon {
  width: 60rpx;
  height: 60rpx;
}

.cart-count {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background-color: #ff7043;
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
