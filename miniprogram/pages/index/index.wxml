<!-- pages/index/index.wxml -->
<view class="container">
  <view class="hero">
    <view class="hero-text">
      <text class="hero-subtitle">源自云南高山的自然味道</text>
      <text class="hero-title">云南茶叶臻选馆</text>
      <text class="hero-desc">甄选 12 款经典茶品，满足收藏与日常品饮需求。</text>
      <view class="hero-actions">
        <button class="btn-outline" bindtap="goToKnowledge">茶叶知识</button>
        <button class="btn-primary" bindtap="goToProfile">个人中心</button>
      </view>
    </view>
    <image class="hero-image" src="https://images.unsplash.com/photo-1498804103079-a6351b050096?auto=format&fit=crop&w=600&q=60" mode="aspectFill"></image>
  </view>

  <view class="section-title">热销茶品</view>
  <view class="goods-grid">
    <block wx:for="{{teas}}" wx:key="id">
      <view class="goods-card">
        <image class="goods-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-desc">{{item.description}}</text>
          <view class="goods-meta">
            <text class="goods-price">￥{{item.price}}</text>
            <text class="goods-stock">库存：{{item.stock}}</text>
          </view>
          <view class="goods-weight">规格：{{item.weight}}</view>
        </view>
        <button class="btn-primary add-btn" bindtap="addToCart" data-id="{{item.id}}">加入购物车</button>
      </view>
    </block>
  </view>
</view>

<!-- 购物车浮动按钮 -->
<view class="cart-fab" bindtap="goToCart">
  <image src="https://img.icons8.com/fluency-systems-filled/96/ffffff/shopping-cart.png" class="cart-icon"></image>
  <view class="cart-count" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
</view>
