/**
 * app.wxss
 * 全局样式表：统一色调与常用布局工具类
 */
page {
  background-color: #f7f7f7;
  font-family: "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  color: #333;
}

.container {
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a5b34;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background-color: #1a5b34;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.btn-primary {
  background-color: #1a5b34;
  color: #fff;
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

.btn-outline {
  background-color: #fff;
  color: #1a5b34;
  border: 2rpx solid #1a5b34;
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}
