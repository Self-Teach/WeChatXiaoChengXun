<view class="profile-page">
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    <view class="user-info">
      <view class="user-name">{{userInfo.nickName}}</view>
      <view class="user-desc">欢迎来到云南茶坊小程序</view>
    </view>
    <button class="login-btn" bindtap="handleLogin">{{isLoggedIn ? '已登录' : '立即登录'}}</button>
  </view>

  <view class="stats-card">
    <view class="stats-item">
      <view class="stats-value">{{stats.orders}}</view>
      <view class="stats-label">我的订单</view>
    </view>
    <view class="stats-item">
      <view class="stats-value">{{stats.pending}}</view>
      <view class="stats-label">待处理商品</view>
    </view>
    <view class="stats-item">
      <view class="stats-value">{{stats.addresses}}</view>
      <view class="stats-label">收货地址</view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-title">订单服务</view>
      <button class="card-link" bindtap="viewOrders">全部订单 ›</button>
    </view>
    <view class="order-grid">
      <block wx:for="{{orderStatusList}}" wx:key="key">
        <view class="order-item" data-status="{{item.key}}" bindtap="handleStatusTap">
          <view class="order-icon">{{item.icon}}</view>
          <view class="order-label">{{item.label}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="card">
    <view class="card-title">常用服务</view>
    <button class="menu-item" bindtap="manageAddress">
      <text>地址管理</text>
      <text class="arrow">›</text>
    </button>
    <button class="menu-item" bindtap="contactService">
      <text>联系客服</text>
      <text class="arrow">›</text>
    </button>
  </view>

  <view class="card">
    <view class="card-title">账号与安全</view>
    <block wx:for="{{accountSecurityOptions}}" wx:key="key">
      <button class="menu-item" data-key="{{item.key}}" bindtap="handleAccountOption">
        <text>{{item.label}}</text>
        <text class="arrow">›</text>
      </button>
    </block>
  </view>
</view>
