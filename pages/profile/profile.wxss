.profile-page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background: #f6f8f7;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1a4c2d, #2d8a55);
  color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx 24rpx;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
}

.user-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.login-btn {
  background-color: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  border: none;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx 0;
  box-shadow: 0 12rpx 24rpx rgba(26, 76, 45, 0.08);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stats-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a4c2d;
}

.stats-label {
  font-size: 24rpx;
  color: #666666;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 24rpx rgba(26, 76, 45, 0.06);
  padding: 24rpx 0;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a4c2d;
}

.card-link {
  color: #2d8a55;
  background: transparent;
  border: none;
  font-size: 26rpx;
  padding: 0;
  line-height: 1;
}

.card-link::after {
  border: none;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  padding: 24rpx;
}

.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 12rpx;
}

.order-icon {
  font-size: 42rpx;
}

.order-label {
  font-size: 24rpx;
  color: #333333;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
  border-bottom: 1rpx solid #f0f0f0;
  background: transparent;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item::after {
  border: none;
}

.arrow {
  font-size: 36rpx;
  color: #cccccc;
}
