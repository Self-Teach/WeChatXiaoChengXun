.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 32rpx;
  background: linear-gradient(135deg, #f1fbf5, #ffffff);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
}

.user-desc {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
}

.login-btn {
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0a8a4a, #13b067);
  color: #ffffff;
}

.login-state {
  font-size: 24rpx;
  color: #0a8a4a;
}

.order-card {
  margin: 0 32rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-title {
  font-size: 32rpx;
  font-weight: 600;
}

.more {
  font-size: 24rpx;
  color: #888888;
}

.order-status {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 12rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f6fbf8 0%, #ffffff 100%);
  box-shadow: 0 12rpx 24rpx rgba(10, 138, 74, 0.08);
}

.status-icon {
  width: 72rpx;
  height: 72rpx;
}

.status-label {
  font-size: 24rpx;
  color: #555555;
}

.quick-card {
  margin: 24rpx 32rpx;
}

.quick-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.quick-grid {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.quick-item {
  flex: 1 1 calc(50% - 20rpx);
  min-width: 280rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f7fbf8 0%, #ffffff 100%);
  box-shadow: 0 12rpx 22rpx rgba(10, 138, 74, 0.08);
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
}

.quick-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.quick-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
}

.quick-desc {
  font-size: 24rpx;
  color: #607068;
  line-height: 1.4;
}

.helper-card {
  margin: 24rpx 32rpx 120rpx;
  text-align: center;
}

.helper-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.helper-desc {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.contact-btn {
  border-radius: 999rpx;
  background: #0a8a4a;
  color: #ffffff;
}
