/**
 * pages/profile/orders/orders.wxss
 * 功能：为订单列表标签与卡片提供布局与配色，配合设计令牌保持一致。
 * 用法：与 orders.wxml 组合使用；标签与卡片均复用 util 工具类。
 * 尺寸（可调）：标签宽 160rpx、高 96rpx；卡片间距 var(--spacing-24)。
 * 背景/配色：选中标签使用 --color-primary；空态卡片使用 text-muted。
 * 位置/布局：tabs 使用横向滚动；列表纵向排列。
 * 交互：标签 active 态添加阴影；按钮 hover 使用 util 定义。
 * 依赖/风险：确保 app.wxss 已引入 util 类。
 */
.tab-scroll { display: flex; gap: var(--spacing-16); }
.tab-item {
  min-width: 160rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-8);
  color: var(--color-muted);
  background: #fff;
}
.tab-item.active {
  color: #fff;
  background: var(--color-primary);
  border-color: transparent;
  box-shadow: 0 12rpx 30rpx rgba(107, 78, 61, 0.2);
}
.tab-icon { width: 56rpx; height: 56rpx; }
.order-list { display: flex; flex-direction: column; }
.order-meta .badge { background: rgba(0, 163, 129, 0.18); color: var(--color-accent); }
.empty-card { color: var(--color-muted); }
