.orders-page {
  padding: 24rpx 32rpx 80rpx;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
}

.tab-item {
  flex: 1 1 45%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 999rpx;
  background: #f3f7f4;
  color: #666666;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #0a8a4a, #13b067);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(10, 138, 74, 0.18);
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-label {
  font-size: 26rpx;
}

.order-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-item {
  padding: 24rpx;
}

.order-id {
  font-size: 24rpx;
  color: #888888;
}

.order-name {
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

.order-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 12rpx 0;
}

.order-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #0a8a4a;
}

.order-status {
  font-size: 26rpx;
  color: #ff8a34;
}

.order-time {
  font-size: 24rpx;
  color: #999999;
}

.order-action {
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #0a8a4a;
  color: #ffffff;
}

.empty {
  text-align: center;
  color: #999999;
  margin-top: 160rpx;
}
