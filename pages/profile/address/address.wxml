<view class="address-page">
  <block wx:for="{{addresses}}" wx:key="id">
    <view class="address-item card">
      <view class="address-header">
        <view class="name">{{item.name}}</view>
        <view class="phone">{{item.phone}}</view>
        <view wx:if="{{item.isDefault}}" class="tag">默认</view>
      </view>
      <view class="region">{{item.region}}</view>
      <view class="detail">{{item.detail}}</view>
      <view class="actions">
        <button size="mini" data-id="{{item.id}}" bindtap="setDefault">设为默认</button>
        <button size="mini" class="edit">编辑</button>
      </view>
    </view>
  </block>

  <button class="add-btn" type="primary" bindtap="addAddress">新增地址</button>
</view>
