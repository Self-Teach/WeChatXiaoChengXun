.container {
  padding-bottom: 160rpx;
}

.banner {
  height: 520rpx;
}

.banner-image {
  width: 100%;
  height: 520rpx;
}

.info-card {
  margin: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-card .title {
  font-size: 40rpx;
  font-weight: 700;
}

.meta-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ecf8f0;
  color: #0a8a4a;
  font-size: 24rpx;
}

.info-card .price {
  font-size: 44rpx;
  color: #e08b22;
  margin: 12rpx 0;
}

.info-card .meta {
  font-size: 24rpx;
  color: #666666;
}

.info-card .desc {
  font-size: 28rpx;
  line-height: 1.6;
}

.flavor-card,
.brew-card {
  margin: 0 32rpx 24rpx;
}

.flavor-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.flavor-chip {
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(10, 138, 74, 0.1), rgba(19, 176, 103, 0.06));
  border: 2rpx solid rgba(10, 138, 74, 0.18);
  color: #0a6a3d;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.4);
}

.pairing {
  font-size: 26rpx;
  color: #55625d;
  line-height: 1.6;
}

.brew-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.brew-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.brew-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #0a8a4a;
  color: #ffffff;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.brew-text {
  flex: 1;
  background: #f4fbf6;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #44534c;
  line-height: 1.6;
}

.option-card,
.quantity-card,
.reviews-card,
.detail-card {
  margin: 24rpx 32rpx;
}

.option-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.option-group {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f5f3;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.quantity-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 50%;
  background: #f0f5f2;
  color: #0a8a4a;
}

.quantity-value {
  font-size: 36rpx;
  font-weight: 600;
}

.review-item {
  display: flex;
  margin-bottom: 24rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.review-user {
  font-size: 28rpx;
  font-weight: 600;
}

.review-date {
  font-size: 24rpx;
  color: #888888;
}

.review-text {
  font-size: 26rpx;
  color: #444444;
  margin-top: 8rpx;
}

.detail-images {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.detail-image {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -12rpx 24rpx rgba(0, 0, 0, 0.06);
}

.share-btn {
  flex: 1;
  border: 1rpx solid #0a8a4a;
  color: #0a8a4a;
  border-radius: 999rpx;
}

.add-btn,
.buy-btn {
  flex: 2;
  border-radius: 999rpx;
}

.buy-btn {
  background: #f5f8f7;
  color: #0a8a4a;
}

.empty {
  padding: 200rpx 0;
  text-align: center;
  color: #888888;
}
