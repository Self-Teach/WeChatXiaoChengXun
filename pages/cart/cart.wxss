.cart-page {
  padding: 24rpx;
  background: #f6f8f7;
}

.cart-card {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(26, 76, 45, 0.06);
}

.cart-img {
  width: 220rpx;
  height: 220rpx;
}

.cart-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cart-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a4c2d;
}

.cart-origin,
.cart-spec {
  font-size: 24rpx;
  color: #666666;
}

.cart-spec {
  color: #2d8a55;
}

.cart-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #d96f2c;
}

.cart-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quantity-text {
  font-size: 28rpx;
  min-width: 48rpx;
  text-align: center;
}

.remove-btn {
  color: #d64545;
  border: 1rpx solid #d64545;
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
}

.summary-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 24rpx rgba(26, 76, 45, 0.08);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 30rpx;
}

.summary-amount {
  font-weight: 700;
  color: #1a4c2d;
}

.summary-actions {
  display: flex;
  gap: 24rpx;
}

.clear-btn {
  flex: 1;
  border: 1rpx solid #1a4c2d;
  color: #1a4c2d;
  border-radius: 32rpx;
  padding: 16rpx 0;
}

.checkout-btn {
  flex: 1;
  background: linear-gradient(135deg, #1a4c2d, #2d8a55);
  color: #ffffff;
  border-radius: 32rpx;
  padding: 16rpx 0;
}

.empty {
  padding: 120rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.empty-img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
}

.go-shop {
  background: linear-gradient(135deg, #1a4c2d, #2d8a55);
  color: #ffffff;
  border-radius: 32rpx;
  padding: 16rpx 48rpx;
}
