/* pages/cart/index.wxss */
.cart-page {
  padding-bottom: 120rpx;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  align-items: center;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}

.select-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #cccccc;
}

.select-icon.checked {
  background-color: #146356;
  border-color: #146356;
}

.cart-item {
  display: flex;
  background-color: #ffffff;
  margin: 0 24rpx 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.04);
  align-items: center;
  gap: 16rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background-color: #f5f5f5;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-name {
  font-size: 30rpx;
  color: #2f4f4f;
  font-weight: 600;
}

.item-spec {
  font-size: 24rpx;
  color: #777777;
}

.item-price {
  font-size: 30rpx;
  color: #c06014;
  font-weight: 600;
}

.quantity-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quantity {
  min-width: 50rpx;
  text-align: center;
}

.delete-btn {
  margin-left: auto;
}

.empty-view {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999999;
  gap: 24rpx;
}

.empty-view image {
  width: 240rpx;
}

.go-home {
  background-color: #146356;
  color: #ffffff;
}

.cart-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  box-shadow: 0 -6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.footer-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.total-price {
  font-size: 32rpx;
  color: #c06014;
  font-weight: 700;
}

.checkout-btn {
  background-color: #c06014;
  color: #ffffff;
  padding: 0 40rpx;
  border-radius: 32rpx;
}
