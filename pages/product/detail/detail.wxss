.detail-page {
  padding-bottom: 160rpx;
  background: #f5f5f5;
}

.hero-img {
  width: 100%;
  height: 480rpx;
}

.info-card {
  margin: -80rpx 24rpx 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 40rpx rgba(26, 76, 45, 0.12);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a4c2d;
}

.price {
  font-size: 44rpx;
  font-weight: 700;
  color: #d96f2c;
  margin: 16rpx 0;
}

.meta {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.section-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a4c2d;
  margin: 24rpx 0 16rpx;
}

.spec-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-item {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f0f6f3;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 26rpx;
  color: #1a4c2d;
  border: 2rpx solid transparent;
}

.spec-item.active {
  border-color: #1a4c2d;
  background: rgba(26, 76, 45, 0.08);
}

.spec-price {
  font-size: 24rpx;
  color: #d96f2c;
}

.quantity-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quantity-control {
  display: inline-flex;
  align-items: center;
  gap: 24rpx;
}

.quantity-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f0f6f3;
  color: #1a4c2d;
  border: none;
  font-size: 32rpx;
  line-height: 64rpx;
}

.quantity-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a4c2d;
}

.share-btn {
  align-self: flex-start;
  padding: 16rpx 32rpx;
  background: rgba(26, 76, 45, 0.1);
  border-radius: 999rpx;
  color: #1a4c2d;
  font-size: 26rpx;
  border: none;
}

.share-btn::after {
  border: none;
}

.section-card {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(26, 76, 45, 0.1);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: rgba(217, 111, 44, 0.1);
  border-radius: 999rpx;
  color: #d96f2c;
  font-size: 24rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #444444;
  font-size: 26rpx;
  line-height: 1.6;
}

.dot {
  color: #1a4c2d;
  font-size: 32rpx;
  line-height: 1;
}

.review-item + .review-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.review-header {
  display: flex;
  justify-content: space-between;
  color: #1a4c2d;
  font-size: 26rpx;
}

.review-meta {
  color: #888888;
  font-size: 24rpx;
}

.review-content {
  margin-top: 12rpx;
  color: #444444;
  font-size: 26rpx;
  line-height: 1.6;
}

.detail-text {
  color: #555555;
  font-size: 26rpx;
  line-height: 1.8;
}

.safe-area {
  height: 120rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10rpx);
  gap: 24rpx;
  box-shadow: 0 -8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.cart-btn,
.buy-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: none;
}

.cart-btn::after,
.buy-btn::after {
  border: none;
}

.cart-btn {
  background: rgba(26, 76, 45, 0.12);
  color: #1a4c2d;
}

.buy-btn {
  background: linear-gradient(135deg, #d96f2c, #ffb36b);
  color: #ffffff;
  font-weight: 600;
}
