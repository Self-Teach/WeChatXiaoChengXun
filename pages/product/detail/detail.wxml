<view class="detail-page" wx:if="{{product}}">
  <image class="hero-img" src="{{product.image}}" mode="aspectFill" />

  <view class="info-card">
    <view class="title">{{product.name}}</view>
    <view class="price">¥{{selectedSpec.price}}</view>
    <view class="meta">产地：{{product.origin}}</view>
    <view class="meta">口感：{{product.flavor}}</view>

    <view class="spec-section">
      <view class="section-header">规格选择</view>
      <view class="spec-list">
        <block wx:for="{{product.specs}}" wx:key="id">
          <view
            class="spec-item {{selectedSpec.id === item.id ? 'active' : ''}}"
            data-spec-id="{{item.id}}"
            bindtap="selectSpec"
          >
            <text>{{item.label}}</text>
            <text class="spec-price">¥{{item.price}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="quantity-row">
      <view class="section-header">购买数量</view>
      <view class="quantity-control">
        <button class="quantity-btn" data-action="minus" bindtap="changeQuantity">-</button>
        <text class="quantity-value">{{quantity}}</text>
        <button class="quantity-btn" data-action="plus" bindtap="changeQuantity">+</button>
      </view>
      <button class="share-btn" open-type="share">分享给好友</button>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">商品亮点</view>
    <view class="tag-list">
      <block wx:for="{{product.highlights}}" wx:key="index">
        <view class="tag">{{item}}</view>
      </block>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">冲泡建议</view>
    <view class="guide-list">
      <block wx:for="{{product.brewGuides}}" wx:key="index">
        <view class="guide-item">
          <text class="dot">•</text>
          <text class="guide-text">{{item}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">茶友评价</view>
    <block wx:for="{{product.reviews}}" wx:key="user">
      <view class="review-item">
        <view class="review-header">
          <view class="review-user">{{item.user}}</view>
          <view class="review-meta">{{item.date}} · {{item.rating}}分</view>
        </view>
        <view class="review-content">{{item.content}}</view>
      </view>
    </block>
  </view>

  <view class="section-card">
    <view class="section-header">商品详情</view>
    <view class="detail-text">{{product.detail}}</view>
  </view>

  <view class="safe-area"></view>
</view>

<view class="bottom-bar" wx:if="{{product}}">
  <button class="cart-btn" bindtap="addToCart">加入购物车</button>
  <button class="buy-btn" bindtap="buyNow">立即购买</button>
</view>
