<!-- pages/order-list/index.wxml -->
<!-- 订单列表页面：根据状态筛选展示订单 -->
<view class="order-page">
  <scroll-view class="status-tabs" scroll-x="true">
    <view
      class="tab-item {{currentStatus === item ? 'active' : ''}}"
      wx:for="{{statusList}}"
      wx:key="*this"
      bindtap="onSwitchStatus"
      data-status="{{item}}"
    >
      {{item}}
    </view>
  </scroll-view>

  <block wx:if="{{displayOrders.length > 0}}">
    <view class="order-card" wx:for="{{displayOrders}}" wx:key="orderId">
      <view class="order-header">
        <text>订单号：{{item.orderId}}</text>
        <text class="status-text">{{item.status}}</text>
      </view>
      <view class="order-body">
        <view class="order-item" wx:for="{{item.items}}" wx:key="{{item.id}}-{{item.specId}}">
          <image src="{{item.image}}" mode="aspectFill"></image>
          <view class="order-item-info">
            <view class="order-item-name">{{item.name}}</view>
            <view class="order-item-spec">规格：{{item.specName}} × {{item.quantity}}</view>
            <view class="order-item-price">￥{{item.subtotal}}</view>
          </view>
        </view>
      </view>
      <view class="order-footer">
        <text>实付金额：<text class="highlight">￥{{item.totalPrice}}</text></text>
        <button size="mini" bindtap="onMockAction" data-id="{{item.orderId}}">查看详情</button>
      </view>
    </view>
  </block>
  <view class="empty" wx:else>
    <image src="/images/empty-order.png" mode="widthFix"></image>
    <text>暂无该状态订单，去挑选喜欢的云南茶吧！</text>
  </view>
</view>
