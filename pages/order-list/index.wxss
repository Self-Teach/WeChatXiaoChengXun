/* pages/order-list/index.wxss */
.order-page {
  padding: 24rpx;
}

.status-tabs {
  display: flex;
  margin-bottom: 20rpx;
}

.tab-item {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background-color: #f0f0f0;
  font-size: 26rpx;
  color: #666666;
}

.tab-item.active {
  background-color: #146356;
  color: #ffffff;
}

.order-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.status-text {
  color: #c06014;
}

.order-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.order-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
}

.order-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-item-name {
  font-size: 28rpx;
  color: #2f4f4f;
}

.order-item-spec {
  font-size: 24rpx;
  color: #777777;
}

.order-item-price {
  font-size: 26rpx;
  color: #c06014;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.highlight {
  color: #c06014;
  font-weight: 700;
}

.empty {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: #999999;
}

.empty image {
  width: 240rpx;
}
