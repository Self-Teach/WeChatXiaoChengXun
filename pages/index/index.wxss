/**
 * pages/index/index.wxss
 * 功能：为首页各功能区块提供精细样式控制，包括横幅、搜索条、筛选抽屉、商品网格与悬浮按钮。
 * 用法：配合 styles/util.wxss 的工具类使用；此文件主要负责特殊布局与尺寸变量。
 * 尺寸：通过自定义属性 --fab-size、--card-gap 控制浮动按钮直径与卡片间距，便于统一修改。
 * 背景/配色：渐变、描边与阴影引用 styles/vars.wxss；若需换主题，请优先调整 vars 中的颜色令牌。
 * 位置/布局：整体页面为相对定位以容纳悬浮购物车；网格采用两列布局，可在 .product-grid 中调整 repeat 值。
 * 交互：芯片 hover/active、骨架屏占位、筛选抽屉开合均在此定义；修改状态类时注意保持过渡平滑。
 * 依赖/风险：部分样式依赖 CSS 变量与 calc，要求基础库 2.10+；若要兼容旧版需改为固定值。
 * 后期修改指引：搜索“// 调整点”快速定位常用调节点；新增模块时优先复用工具类，必要时在此补充专用类。
 */

:root {
  --fab-size: 120rpx; /* 调整悬浮按钮直径，范围建议 96rpx~140rpx */
  --card-gap: var(--spacing-24); /* 控制商品卡片之间的水平/垂直间距 */
}

.home-page {
  position: relative; /* 让悬浮购物车使用绝对定位时相对于页面容器 */
  padding-bottom: calc(var(--fab-size) + var(--spacing-32)); /* 为悬浮按钮留出底部空间，避免遮挡内容 */
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden; /* 确保圆角卡片不溢出 */
  background: linear-gradient(135deg, rgba(10, 138, 74, 0.08), #ffffff); /* 横幅背景渐变，可替换为纯色 */
}

.hero-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-12);
}

.title {
  font-size: 48rpx; /* 主标题字号：如需更醒目可调至 56rpx */
  font-weight: 700;
  color: var(--color-text);
}

.hero-image {
  width: 240rpx; /* 图片宽度，建议根据素材等比例调整 */
  height: 240rpx;
  border-radius: var(--radius-lg);
  margin-left: var(--spacing-24);
}

.search-bar {
  margin-top: var(--spacing-24);
  border-radius: 999rpx; /* 药丸形输入框，可改为 var(--radius-lg) 获得更硬朗风格 */
  align-items: center;
  background: #ffffff;
}

.search-input {
  flex: 1;
  font-size: var(--font-md);
}

.placeholder {
  color: rgba(10, 138, 74, 0.36); /* 提示文字使用主色的 36% 透明度，若嫌过浅可调高 */
}

.clear-btn {
  color: var(--color-primary);
  font-size: var(--font-sm);
}

.icon-32 {
  width: 32rpx;
  height: 32rpx;
}

.icon-28 {
  width: 28rpx;
  height: 28rpx;
}

.suggestion-panel {
  border-radius: var(--radius-lg);
}

.suggestion-chip {
  padding: var(--spacing-8) var(--spacing-16);
  border-radius: var(--radius-md);
  background: rgba(10, 138, 74, 0.08);
  font-size: var(--font-sm);
}

.sort-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-16);
}

.sort-scroll {
  flex: 1;
  display: flex;
  column-gap: var(--spacing-16);
}

.sort-chip {
  min-width: 220rpx; /* 排序卡片宽度，可视需求增减 */
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(10, 138, 74, 0.12);
  padding: var(--spacing-12) var(--spacing-16);
  background: #ffffff;
  transition: all 0.2s ease;
}

.sort-chip.active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #ffffff;
  border-color: transparent;
  box-shadow: var(--shadow-sm);
}

.sort-desc {
  opacity: 0.7;
}

.filter-entry {
  width: 152rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  border: 1rpx dashed rgba(10, 138, 74, 0.4); /* 虚线边框突出为筛选入口 */
  color: var(--color-primary);
  gap: var(--spacing-8);
}

.type-tabs {
  display: flex;
  gap: var(--spacing-16);
  margin-top: var(--spacing-24);
  padding-bottom: var(--spacing-8);
}

.type-chip {
  padding: var(--spacing-12) var(--spacing-24);
  border-radius: 18rpx; /* 方形视觉，可改为 var(--radius-md) 获得更硬朗效果 */
  background: #ffffff;
  font-size: var(--font-sm);
  font-weight: 600;
  color: #4f5f58;
  border: 1rpx solid rgba(10, 138, 74, 0.2);
  min-width: 180rpx;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(10, 138, 74, 0.06);
  transition: all 0.2s ease;
}

.type-chip.active {
  background: linear-gradient(135deg, #f1fbf5, rgba(10, 138, 74, 0.16));
  color: var(--color-primary);
  border-color: transparent;
}

.skeleton-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--card-gap);
  margin-top: var(--spacing-24);
}

.skeleton-card {
  height: 360rpx; /* 占位高度接近真实卡片高度，后续可根据图片比例调整 */
  border-radius: var(--radius-lg);
  background: linear-gradient(120deg, rgba(10, 138, 74, 0.08), rgba(255, 255, 255, 0.5));
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0% { opacity: 0.7; }
  50% { opacity: 1; }
  100% { opacity: 0.7; }
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--card-gap);
  margin-top: var(--spacing-24);
}

.product-card {
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-md);
}

.product-type {
  font-size: var(--font-xs);
  color: var(--color-primary);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(10, 138, 74, 0.12);
}

.product-brief {
  line-height: 1.6;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-8);
}

.tag {
  padding: var(--spacing-4) var(--spacing-12);
  border-radius: 999rpx;
  background: rgba(10, 138, 74, 0.1);
  font-size: var(--font-xs);
}

.tasting-chip {
  padding: var(--spacing-8) var(--spacing-16);
  border-radius: var(--radius-md);
  background: rgba(194, 107, 58, 0.1); /* 使用特产橙色弱化显示 */
  font-size: var(--font-sm);
}

.product-origin {
  letter-spacing: 2rpx;
}

.product-actions__add {
  width: 100%;
  justify-content: center;
  border-radius: var(--radius-md);
}

.product-actions__icon {
  width: 32rpx;
  height: 32rpx;
}

.empty-state {
  margin-top: var(--spacing-24);
  text-align: center;
}

.page-footer__icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
}

.cart-fab {
  position: fixed;
  right: var(--spacing-24);
  bottom: calc(var(--spacing-32) + constant(safe-area-inset-bottom));
  bottom: calc(var(--spacing-32) + env(safe-area-inset-bottom));
  width: var(--fab-size);
  height: var(--fab-size);
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  box-shadow: var(--shadow-lg);
  color: #ffffff;
  z-index: 99;
}

.cart-fab__icon {
  width: 56rpx;
  height: 56rpx;
}

.cart-fab__badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 36rpx;
  padding: 4rpx 8rpx;
  background: #ff5f5f;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  text-align: center;
}

.filter-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35); /* 遮罩透明度，可在 0.25~0.45 间调整 */
  z-index: 90;
}

.filter-sheet {
  position: fixed;
  right: 0;
  top: 0;
  bottom: 0;
  width: 70%; /* 抽屉宽度，可根据内容多寡调整在 60%~80% */
  padding: var(--spacing-24);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-24);
  z-index: 91;
}

.filter-sheet__header {
  align-items: center;
}

.filter-scroll {
  flex: 1;
}

.filter-group {
  margin-bottom: var(--spacing-32);
}

.filter-group__tip {
  margin-top: var(--spacing-8);
}

.filter-chip {
  padding: var(--spacing-8) var(--spacing-16);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(10, 138, 74, 0.2);
  background: #ffffff;
  font-size: var(--font-sm);
  transition: all 0.2s;
}

.filter-chip.selected {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #ffffff;
  border-color: transparent;
  box-shadow: var(--shadow-sm);
}

.filter-actions {
  gap: var(--spacing-16);
}
