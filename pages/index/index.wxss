/* pages/index/index.wxss */
.page-index {
  padding: 20rpx 24rpx 120rpx 24rpx;
}

.banner {
  position: relative;
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.banner image {
  width: 100%;
  height: 100%;
}

.banner-text {
  position: absolute;
  left: 32rpx;
  bottom: 32rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.banner-title {
  font-size: 40rpx;
  font-weight: 600;
}

.banner-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 48%;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.product-image {
  width: 100%;
  height: 220rpx;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2f4f4f;
}

.product-tags {
  margin: 12rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  font-size: 22rpx;
  color: #146356;
  background-color: #e9f5f1;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 16rpx;
  min-height: 66rpx;
}

.product-price {
  color: #c06014;
  font-size: 32rpx;
  font-weight: 700;
}

.mini-btn {
  background-color: #146356;
  color: #ffffff;
  padding: 0 20rpx;
}

.cart-floating {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 140rpx;
  height: 140rpx;
  background-color: rgba(20, 99, 86, 0.92);
  border-radius: 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(20, 99, 86, 0.35);
}

.cart-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.cart-text {
  font-size: 24rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background-color: #e63946;
  color: #ffffff;
  border-radius: 20rpx;
  padding: 4rpx 10rpx;
  font-size: 22rpx;
}
