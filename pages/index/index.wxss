.home {
  padding-bottom: 220rpx;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f1fbf5 0%, #ffffff 100%);
}

.hero-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #0a8a4a;
  letter-spacing: 4rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
}

.desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.hero-image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 24rpx;
  margin-left: 24rpx;
}

.search {
  margin: 0 32rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 999rpx;
  padding: 18rpx 24rpx;
}

.search-icon,
.filter-icon {
  width: 40rpx;
  height: 40rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.placeholder {
  color: #a8b5ad;
}

.search-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #0a8a4a;
}

.type-tabs {
  display: flex;
  gap: 16rpx;
  margin: 0 32rpx 24rpx;
  padding-bottom: 8rpx;
}

.type-chip {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #f1f5f3;
  color: #4f5f58;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.type-chip.active {
  background: linear-gradient(135deg, #0a8a4a, #13b067);
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(10, 138, 74, 0.2);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 24rpx;
  padding: 0 32rpx 32rpx;
}

.product-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 28rpx rgba(10, 138, 74, 0.08);
  transition: transform 0.3s;
}

.product-card:active {
  transform: scale(0.98);
}

.product-image {
  width: 100%;
  height: 220rpx;
}

.product-info {
  padding: 20rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  flex: 1;
}

.product-type {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecf8f0;
  color: #0a8a4a;
}

.product-brief {
  font-size: 24rpx;
  line-height: 1.5;
  min-height: 70rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #0a8a4a;
  background: #f1fbf5;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.tasting-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tasting-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(19, 176, 103, 0.12);
  color: #0a8a4a;
  font-size: 22rpx;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #e08b22;
  font-size: 32rpx;
  font-weight: 700;
}

.rating {
  color: #0a8a4a;
  font-size: 24rpx;
}

.product-origin {
  font-size: 24rpx;
  color: #697973;
}

.empty-state {
  margin: 0 32rpx 32rpx;
  text-align: center;
  padding: 48rpx 32rpx;
  background: #f7faf8;
  border: 1rpx dashed rgba(10, 138, 74, 0.2);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #607068;
  line-height: 1.6;
}

.cart-fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #0a8a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(10, 138, 74, 0.2);
  color: #ffffff;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  z-index: 10;
}

.cart-fab:active {
  transform: translateY(4rpx) scale(0.96);
  box-shadow: 0 12rpx 24rpx rgba(10, 138, 74, 0.18);
}

.cart-fab__icon {
  width: 48rpx;
  height: 48rpx;
}

.cart-fab__badge {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 44rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #ff6b3d;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 10rpx 20rpx rgba(255, 107, 61, 0.28);
}
