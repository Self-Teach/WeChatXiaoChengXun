.page {
  position: relative;
  padding-bottom: 120rpx;
}

.hero {
  position: relative;
  height: 360rpx;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  overflow: hidden;
}

.hero-bg {
  width: 100%;
  height: 100%;
  filter: brightness(0.75);
}

.hero-content {
  position: absolute;
  left: 48rpx;
  bottom: 48rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  line-height: 1.6;
  width: 80%;
}

.tea-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 24rpx;
}

.tea-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 24rpx rgba(26, 76, 45, 0.08);
  display: flex;
  flex-direction: column;
}

.tea-img {
  width: 100%;
  height: 220rpx;
}

.tea-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tea-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a4c2d;
}

.tea-origin,
.tea-flavor {
  font-size: 24rpx;
  color: #666666;
}

.tea-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.tea-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #d96f2c;
}

.add-btn {
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1a4c2d, #2d8a55);
  color: #ffffff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border: none;
}

.cart-float {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(26, 76, 45, 0.92);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
  color: #ffffff;
}

.cart-icon {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}

.cart-count {
  font-size: 28rpx;
  font-weight: 600;
}
