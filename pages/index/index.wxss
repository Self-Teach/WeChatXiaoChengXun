/* 页面容器，负责整体内边距和底部留白，确保悬浮购物车不遮挡内容 */
.home {
  padding-bottom: 220rpx;
}

/* 顶部横幅卡片，用于展示宣传标题和主题插画 */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f1fbf5 0%, #ffffff 100%);
}

/* 横幅中的文案区域，采用纵向排列呈现 */
.hero-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 副标题文字样式，强调产地信息 */
.subtitle {
  font-size: 26rpx;
  color: #0a8a4a;
  letter-spacing: 4rpx;
}

/* 主标题字号较大以吸引视线 */
.title {
  font-size: 52rpx;
  font-weight: 700;
}

/* 横幅说明文字，配合浅灰色形成轻量阅读感 */
.desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 横幅插画尺寸及圆角控制 */
.hero-image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 24rpx;
  margin-left: 24rpx;
}

/* 搜索条容器，圆角与内边距营造贴心感 */
.search {
  margin: 0 32rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 999rpx;
  padding: 18rpx 24rpx;
}

/* 搜索与筛选图标的统一尺寸 */
.search-icon,
.filter-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 搜索输入框样式，拉伸占满剩余空间 */
.search-input {
  flex: 1;
  font-size: 26rpx;
}

/* 输入提示文字颜色，提示仍可修改 */
.placeholder {
  color: #a8b5ad;
}

/* 搜索操作区域，用于容纳筛选图标与清空按钮 */
.search-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 清空按钮颜色呼应品牌主色 */
.clear-btn {
  font-size: 26rpx;
  color: #0a8a4a;
}

/* 分类标签外层滚动容器，支持横向滚动 */
.type-tabs {
  display: flex;
  gap: 16rpx;
  margin: 0 32rpx 24rpx;
  padding-bottom: 8rpx;
}

/* 分类标签样式，可在此调整背景、圆角以及阴影风格 */
.type-chip {
  padding: 22rpx 36rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid rgba(10, 138, 74, 0.12);
  color: #4f5f58;
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 16rpx;
  min-width: 176rpx;
  text-align: center;
  box-shadow: 0 12rpx 20rpx rgba(10, 138, 74, 0.06);
  transition: all 0.2s ease;
}

/* 激活态渐变背景，形成更具层次的方形卡片效果 */
.type-chip.active {
  background: linear-gradient(135deg, #0a8a4a, #13b067);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 20rpx 32rpx rgba(10, 138, 74, 0.25);
}

/* 商品宫格容器，使用网格布局排列卡片 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 24rpx;
  padding: 0 32rpx 32rpx;
}

/* 单个商品卡片的基础视觉样式 */
.product-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 28rpx rgba(10, 138, 74, 0.08);
  transition: transform 0.3s;
}

.product-card:active {
  transform: scale(0.98);
}

.product-image {
  width: 100%;
  height: 220rpx;
}

.product-info {
  padding: 20rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  flex: 1;
}

.product-type {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecf8f0;
  color: #0a8a4a;
}

.product-brief {
  font-size: 24rpx;
  line-height: 1.5;
  min-height: 70rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #0a8a4a;
  background: #f1fbf5;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.tasting-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tasting-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(19, 176, 103, 0.12);
  color: #0a8a4a;
  font-size: 22rpx;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #e08b22;
  font-size: 32rpx;
  font-weight: 700;
}

.rating {
  color: #0a8a4a;
  font-size: 24rpx;
}

.product-origin {
  font-size: 24rpx;
  color: #697973;
}

.empty-state {
  margin: 0 32rpx 32rpx;
  text-align: center;
  padding: 48rpx 32rpx;
  background: #f7faf8;
  border: 1rpx dashed rgba(10, 138, 74, 0.2);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #607068;
  line-height: 1.6;
}

.cart-fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #0a8a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(10, 138, 74, 0.2);
  color: #ffffff;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  z-index: 10;
}

.cart-fab:active {
  transform: translateY(4rpx) scale(0.96);
  box-shadow: 0 12rpx 24rpx rgba(10, 138, 74, 0.18);
}

.cart-fab__icon {
  width: 48rpx;
  height: 48rpx;
}

.cart-fab__badge {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 44rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #ff6b3d;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 10rpx 20rpx rgba(255, 107, 61, 0.28);
}

.page-footer {
  margin: 0 32rpx 160rpx;
  padding: 32rpx 28rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.page-footer__icon {
  width: 88rpx;
  height: 88rpx;
}

.page-footer__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0a8a4a;
}

.page-footer__desc {
  font-size: 26rpx;
  color: #55625d;
  line-height: 1.7;
}
