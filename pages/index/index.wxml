<!-- pages/index/index.wxml -->
<!-- 首页：展示云南茶叶商品列表以及购物车浮动按钮 -->
<view class="page-index">
  <!-- 顶部横幅，实际项目中需要将图片放入 /images 目录 -->
  <view class="banner">
    <image src="/images/banner-tea.jpg" mode="aspectFill"></image>
    <view class="banner-text">
      <text class="banner-title">云南好茶，滋味山野</text>
      <text class="banner-sub">严选八大山头好茶，让您在家喝到云南味道</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="section-title">热销精选</view>
  <view class="product-list">
    <block wx:for="{{teaList}}" wx:key="id">
      <view class="product-card" bindtap="onTapProduct" data-id="{{item.id}}">
        <image class="product-image" src="{{item.images[0]}}" mode="aspectFill"></image>
        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{tag}}</text>
          </view>
          <view class="product-desc">{{item.desc}}</view>
          <view class="flex-between">
            <text class="product-price">￥{{item.price}}</text>
            <button class="mini-btn" size="mini" type="default" bindtap.stop="onAddToCart" data-id="{{item.id}}">加入购物车</button>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 购物车浮动按钮 -->
  <view class="cart-floating" bindtap="goCart">
    <image class="cart-icon" src="/images/icon-cart-floating.png" mode="aspectFit"></image>
    <text class="cart-text">购物车</text>
    <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
  </view>
</view>
