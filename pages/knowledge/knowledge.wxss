.page-badge {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  margin: 32rpx 32rpx 0;
}

.page-badge__icon {
  width: 72rpx;
  height: 72rpx;
}

.page-badge__text {
  font-size: 32rpx;
  font-weight: 600;
  color: #0a8a4a;
}

.intro {
  margin: 32rpx;
}

.intro .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0a8a4a;
  margin-bottom: 12rpx;
}

.intro .desc {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
}

.quick-facts {
  margin: 0 32rpx 24rpx;
}

.quick-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.quick-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0a8a4a;
}

.quick-desc {
  font-size: 26rpx;
  color: #6a6a6a;
}

.quick-scroll {
  display: flex;
  gap: 24rpx;
  padding-bottom: 12rpx;
}

.fact-card {
  width: 260rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #f4fbf6, #ffffff);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-right: 24rpx;
  box-shadow: 0 10rpx 20rpx rgba(10, 138, 74, 0.1);
}

.fact-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
}

.fact-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 12rpx;
}

.fact-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.origin-highlights {
  margin: 0 32rpx 24rpx;
}

.origin-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 16rpx;
}

.origin-item {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f7faf8;
  border: 1rpx solid rgba(10, 138, 74, 0.08);
}

.origin-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 8rpx;
}

.origin-summary {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
}

.culture-card {
  margin: 0 32rpx 24rpx;
}

.culture-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 16rpx;
}

.culture-item {
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fefdf8, #f4fbf6);
  border: 1rpx solid rgba(10, 138, 74, 0.08);
  box-shadow: 0 10rpx 18rpx rgba(10, 138, 74, 0.06);
}

.culture-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 8rpx;
}

.culture-excerpt {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
}

.brew-guide {
  margin: 0 32rpx 24rpx;
}

.brew-steps {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 16rpx;
}

.brew-step {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.step-index {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #0a8a4a;
  color: #ffffff;
  font-weight: 600;
}

.step-content {
  flex: 1;
  background: #f4fbf6;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
}

.section {
  margin: 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.section-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.section-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f0f7f4;
  padding: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-desc {
  font-size: 26rpx;
  color: #777777;
  margin-top: 8rpx;
}

.section-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #0a8a4a;
  font-weight: 600;
}

.toggle-arrow {
  width: 20rpx;
  height: 20rpx;
  border-right: 4rpx solid #0a8a4a;
  border-bottom: 4rpx solid #0a8a4a;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.toggle-arrow.expanded {
  transform: rotate(-135deg);
}

.section-body {
  margin-top: 20rpx;
  border-top: 1rpx dashed #e1e8e3;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.knowledge-item {
  background: #f7faf8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 12rpx;
}

.item-content {
  font-size: 26rpx;
  color: #444444;
  line-height: 1.6;
}
