/* 顶部简介区域，控制整体外边距 */
.intro {
  margin: 32rpx;
}

/* 简介标题样式，突出品牌色 */
.intro .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0a8a4a;
  margin-bottom: 12rpx;
}

/* 简介正文说明，采用浅灰提升可读性 */
.intro .desc {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
}

/* 茶知识速览区域边距 */
.quick-facts {
  margin: 0 32rpx 24rpx;
}

/* 速览标题与描述的垂直排列 */
.quick-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

/* 速览标题颜色与字重 */
.quick-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0a8a4a;
}

/* 速览说明文字样式 */
.quick-desc {
  font-size: 26rpx;
  color: #6a6a6a;
}

/* 横向滚动容器，承载速览卡片 */
.quick-scroll {
  display: flex;
  gap: 24rpx;
  padding-bottom: 12rpx;
}

/* 单个速览卡片样式，使用渐变与阴影塑造层次 */
.fact-card {
  width: 260rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #f4fbf6, #ffffff);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-right: 24rpx;
  box-shadow: 0 10rpx 20rpx rgba(10, 138, 74, 0.1);
}

/* 速览图标尺寸与下边距 */
.fact-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
}

/* 速览卡片标题强调 */
.fact-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 12rpx;
}

/* 速览卡片正文描述 */
.fact-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

/* 产地亮点区块外边距 */
.origin-highlights {
  margin: 0 32rpx 24rpx;
}

/* 产地列表布局为纵向卡片 */
.origin-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 16rpx;
}

.origin-item {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f7faf8;
  border: 1rpx solid rgba(10, 138, 74, 0.08);
}

.origin-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 8rpx;
}

.origin-summary {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
}

.culture-card {
  margin: 0 32rpx 24rpx;
}

.culture-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 16rpx;
}

.culture-item {
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fefdf8, #f4fbf6);
  border: 1rpx solid rgba(10, 138, 74, 0.08);
  box-shadow: 0 10rpx 18rpx rgba(10, 138, 74, 0.06);
}

.culture-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 8rpx;
}

.culture-excerpt {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
}

.brew-guide {
  margin: 0 32rpx 24rpx;
}

.brew-steps {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 16rpx;
}

.brew-step {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.step-index {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #0a8a4a;
  color: #ffffff;
  font-weight: 600;
}

.step-content {
  flex: 1;
  background: #f4fbf6;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
}

.section {
  margin: 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.section-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.section-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f0f7f4;
  padding: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-desc {
  font-size: 26rpx;
  color: #777777;
  margin-top: 8rpx;
}

.section-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #0a8a4a;
  font-weight: 600;
}

.toggle-arrow {
  width: 20rpx;
  height: 20rpx;
  border-right: 4rpx solid #0a8a4a;
  border-bottom: 4rpx solid #0a8a4a;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.toggle-arrow.expanded {
  transform: rotate(-135deg);
}

.section-body {
  margin-top: 20rpx;
  border-top: 1rpx dashed #e1e8e3;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.knowledge-item {
  background: #f7faf8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 12rpx;
}

.item-content {
  font-size: 26rpx;
  color: #444444;
  line-height: 1.6;
}

.page-footer {
  margin: 32rpx 32rpx 96rpx;
  padding: 32rpx 28rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.page-footer__icon {
  width: 92rpx;
  height: 92rpx;
}

.page-footer__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0a8a4a;
}

.page-footer__desc {
  font-size: 26rpx;
  color: #4f5f58;
  line-height: 1.8;
}
