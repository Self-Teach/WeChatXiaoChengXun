.intro {
  margin: 32rpx;
}

.intro .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0a8a4a;
  margin-bottom: 12rpx;
}

.intro .desc {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
}

.section {
  margin: 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.section-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.section-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f0f7f4;
  padding: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-desc {
  font-size: 26rpx;
  color: #777777;
  margin-top: 8rpx;
}

.section-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #0a8a4a;
  font-weight: 600;
}

.toggle-arrow {
  width: 20rpx;
  height: 20rpx;
  border-right: 4rpx solid #0a8a4a;
  border-bottom: 4rpx solid #0a8a4a;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.toggle-arrow.expanded {
  transform: rotate(-135deg);
}

.section-body {
  margin-top: 20rpx;
  border-top: 1rpx dashed #e1e8e3;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.knowledge-item {
  background: #f7faf8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a8a4a;
  margin-bottom: 12rpx;
}

.item-content {
  font-size: 26rpx;
  color: #444444;
  line-height: 1.6;
}
