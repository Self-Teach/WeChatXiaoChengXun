/**
 * pages/knowledge/knowledge.wxss
 * 功能：为科普页的目录、速览卡片、折叠面板与分享区提供定制样式，同时复用设计令牌。
 * 用法：与 knowledge.wxml 搭配使用，页面主容器使用 page-container；新增模块时在此补充对应类。
 * 尺寸（可调）：目录芯片 220rpx×72rpx、fact 卡片宽 260rpx；间距统一依赖 --spacing-* 变量。
 * 背景/配色：主色取 --color-primary，强调色使用 --color-accent；若需深色模式，可新增 data-theme 覆盖色值。
 * 位置/布局：scroll-view 设置 gap 与内边距；折叠面板通过 rotate 处理箭头旋转，保持视觉一致。
 * 交互：目录选中态添加 box-shadow 与色彩强化；折叠箭头根据 expanded class 旋转 180° 提示状态。
 * 依赖/风险：需确保 util.wxss 中的工具类已引入；锚点滚动依赖 .knowledge-section 上的 id 与 data-anchor。
 * 后期修改指引：若要扩展更多卡片样式，优先使用 .card + 工具类；特殊尺寸另行定义变量再应用。
 */
.knowledge-page { padding-bottom: calc(var(--spacing-48) + 120rpx); }

.catalog-card { position: relative; }
.catalog-header button { margin-left: var(--spacing-24); }
.catalog-scroll {
  margin-top: var(--spacing-20);
  display: flex;
  gap: var(--spacing-16);
  padding-bottom: var(--spacing-8);
}
.catalog-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-12);
  width: 220rpx;
  height: 72rpx;
  padding: 0 var(--spacing-16);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--color-line);
  background: #fff;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}
.catalog-chip.is-active {
  background: var(--color-accent);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 10rpx 28rpx rgba(0, 163, 129, 0.24);
}
.catalog-chip.is-active .chip-index { background: rgba(255, 255, 255, 0.2); color: #ffffff; }
.catalog-chip.is-active .chip-label { color: #ffffff; }
.chip-label { font-size: var(--font-sm); line-height: var(--line-sm); color: var(--color-text); }

.intro-card { background: linear-gradient(135deg, rgba(107, 78, 61, 0.08), rgba(0, 163, 129, 0.08)); }

.quick-scroll {
  margin-top: var(--spacing-20);
  display: flex;
  gap: var(--spacing-20);
}
.fact-card {
  width: 260rpx;
  min-height: 240rpx;
  border-radius: var(--radius-lg);
  padding: var(--spacing-20);
  background: var(--color-card);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-12);
}
.fact-icon { width: 88rpx; height: 88rpx; }

.origin-list, .culture-list { display: flex; flex-direction: column; gap: var(--spacing-16); margin-top: var(--spacing-20); }
.origin-item, .culture-item {
  padding: var(--spacing-16);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  background: #fff;
}

.brew-steps { display: flex; flex-direction: column; gap: var(--spacing-16); margin-top: var(--spacing-20); }
.brew-step {
  display: flex;
  gap: var(--spacing-16);
  padding: var(--spacing-16);
  border-radius: var(--radius-md);
  background: rgba(107, 78, 61, 0.05);
}
.step-index { width: 48rpx; text-align: center; color: var(--color-primary); }
.step-content { flex: 1; display: flex; flex-direction: column; gap: var(--spacing-8); }

.knowledge-section { border: 1rpx solid var(--color-line); }
.section-header { gap: var(--spacing-16); }
.section-icon { width: 88rpx; height: 88rpx; }
.toggle-indicator {
  width: 28rpx;
  height: 28rpx;
  border-top: 4rpx solid var(--color-primary);
  border-right: 4rpx solid var(--color-primary);
  transform: rotate(45deg);
  transition: transform 0.2s;
}
.toggle-indicator.expanded { transform: rotate(-135deg); }
.section-body { display: flex; flex-direction: column; gap: var(--spacing-20); }
.knowledge-item {
  padding: var(--spacing-16);
  border-radius: var(--radius-md);
  background: rgba(0, 163, 129, 0.06);
}

.share-card button { width: 100%; }

.page-footer__icon { width: 96rpx; height: 96rpx; }
