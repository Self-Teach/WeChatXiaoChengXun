.detail-page {
  padding: 32rpx 24rpx 120rpx;
  background: #f6f8f7;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.header {
  background: linear-gradient(160deg, #1a4c2d 0%, #2d8a55 100%);
  color: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.summary {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.share-btn {
  align-self: flex-start;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #1a4c2d;
  background: #ffffff;
  border: none;
}

.share-btn::after {
  border: none;
}

.section {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 28rpx rgba(26, 76, 45, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a4c2d;
  margin-bottom: 20rpx;
}

.paragraph {
  font-size: 26rpx;
  color: #444444;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.tip-item {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.dot {
  color: #2d8a55;
  font-size: 32rpx;
  line-height: 1;
}

.tip-text {
  font-size: 26rpx;
  color: #444444;
  line-height: 1.6;
}
